<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationIcon>Resources\MiniLaunch.ico</ApplicationIcon>

		<AssemblyName>MiniLaunch</AssemblyName>
		<Title>MiniLaunch</Title>
		<Product>MiniLaunch</Product>
		<Description>Launch and organize application workspaces from the system tray.</Description>

		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<InformationalVersion>1.0.0</InformationalVersion>

		<!-- 🔥 SAME AS MINIHIDE -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>

		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<InvariantGlobalization>true</InvariantGlobalization>

		<!-- 🚫 NO SYMBOLS -->
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Resources\about.ico" />
		<None Remove="Resources\exit.ico" />
		<None Remove="Resources\help.ico" />
		<None Remove="Resources\MiniLaunch.ico" />
		<None Remove="Resources\profile.ico" />
		<None Remove="Resources\settings.ico" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\about.ico" />
		<EmbeddedResource Include="Resources\exit.ico" />
		<EmbeddedResource Include="Resources\help.ico" />
		<EmbeddedResource Include="Resources\MiniLaunch.ico" />
		<EmbeddedResource Include="Resources\profile.ico" />
		<EmbeddedResource Include="Resources\settings.ico" />
	</ItemGroup>

</Project>